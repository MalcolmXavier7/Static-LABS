# Port Manager Configuration

# Server Port
PORT_MANAGER_PORT=3001

# Port Pool Range
PORT_POOL_MIN=3100
PORT_POOL_MAX=3199

# Health Check Scheduling (cron format)
# "*/30 * * * * *" = every 30 seconds
# "0 */5 * * * *" = every 5 minutes
# "0 0 * * * *" = every hour
HEALTH_CHECK_INTERVAL="*/30 * * * * *"

# Database Path
DB_PATH=./data/static-labs.db

# Logging Level
LOG_LEVEL=info
